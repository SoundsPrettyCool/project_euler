{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: create build folder",
            "type": "process",
            "command": "mkdir",
            "args": ["-p", "${workspaceFolder}/build"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "C++: build active file",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "dependsOn": "C++: create build folder",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile the open .cpp file into build/"
        },
        {
            "label": "C++: build and run active file",
            "type": "process",
            "command": "${workspaceFolder}/build/${fileBasenameNoExtension}",
            "dependsOn": "C++: build active file",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Compile the open .cpp file and run it"
        }
    ]
}
